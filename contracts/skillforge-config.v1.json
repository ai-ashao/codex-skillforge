{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-ashao/codex-skillforge/contracts/skillforge-config.v1.json",
  "title": "SkillForge per-Skill metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "type": {
          "enum": ["deterministic", "procedural", "hybrid"]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triggers": {
          "$ref": "#/$defs/localPath"
        },
        "behavior": {
          "$ref": "#/$defs/localPath"
        },
        "rubric": {
          "$ref": "#/$defs/localPath"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["git-parent", "explicit"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "explicit"
              }
            }
          },
          "then": {
            "required": ["ref"]
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "enum": [
              "package",
              "resources",
              "scripts",
              "safety",
              "evidence",
              "triggers"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "localPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*://).+"
    }
  }
}
